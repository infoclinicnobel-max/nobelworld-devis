# Projet Supabase « clinic-nobel-crm-prod »
# Ces deux valeurs sont également à déclarer dans Vercel (production, préproduction, développement).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lien de paiement Paysera (16/09/2026) — variables SERVEUR, jamais NEXT_PUBLIC_.
# Le secret authentifie l'appel de la route app/api/paysera/lien-devis vers
# l'endpoint interne du site clinicnobel.com ; il doit être IDENTIQUE à la
# valeur posée côté clinicnobel-next. Veys le fournit directement : il ne se
# recopie dans aucune conversation ni aucun dépôt.
INTERNAL_PAYMENT_LINK_SECRET=
# Facultatif : base de l'endpoint (défaut https://www.clinicnobel.com).
# CLINICNOBEL_SITE_URL=
